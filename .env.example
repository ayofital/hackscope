# Copy this file to .env and add your own secret locally.
# Gemini is preferred when available; Ollama is the local fallback when enabled.
GEMINI_API_KEY=

# Optional: override the Gemini model.
# GEMINI_MODEL=gemini-3.6-flash

# Optional paid fallback.
OPENAI_API_KEY=

# Optional: override the OpenAI model.
# OPENAI_MODEL=gpt-5.5

# Optional local fallback. Install Ollama, pull this model, then uncomment.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Identical inputs are cached locally for 24 hours by default.
# RESEARCH_CACHE_TTL_HOURS=24
